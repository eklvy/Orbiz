# CampusCart — master list of environment variables (placeholders only, never real values).
# Each app/service has its own .env.example containing only what it reads.
# Variables are introduced in the phase noted; unset variables for future phases are expected.

# --- services/api (Phase 0) ---
CAMPUSCART_ENVIRONMENT=local            # local | test | staging | production
CAMPUSCART_LOG_LEVEL=INFO
CAMPUSCART_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:8081"]

# --- Supabase (Phase 1) — server-side only ---
CAMPUSCART_SUPABASE_URL=http://127.0.0.1:54321            # JWT issuer = {url}/auth/v1, JWKS from it
CAMPUSCART_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres  # local stack default
# CAMPUSCART_SUPABASE_JWT_SECRET=server-only               # only for legacy HS256-signed projects
CAMPUSCART_JWT_AUDIENCE=authenticated
CAMPUSCART_DB_POOL_MIN_SIZE=1
CAMPUSCART_DB_POOL_MAX_SIZE=10

# --- Web apps (Phase 3/4) — browser-exposed, public values only ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# --- Mobile app (Phase 3) — bundled into the app, public values only ---
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000
# EXPO_PUBLIC_SUPABASE_URL=...
# EXPO_PUBLIC_SUPABASE_ANON_KEY=...

# --- Payments (Phase 5) — Razorpay TEST mode keys only during development ---
# CAMPUSCART_RAZORPAY_KEY_ID=rzp_test_xxx
# CAMPUSCART_RAZORPAY_KEY_SECRET=server-only
# CAMPUSCART_RAZORPAY_WEBHOOK_SECRET=server-only

# --- Push notifications (Phase 5) ---
# CAMPUSCART_EXPO_ACCESS_TOKEN=server-only

# --- Intelligence (Phases 6–7) ---
# CAMPUSCART_RL_MODEL_DIR=./ml/artifacts
# CAMPUSCART_LLM_PROVIDER=none          # BiteBot must work (degraded) with no provider
