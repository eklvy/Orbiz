# Bundled into the app: public values only (URLs and the anon key). Never put secrets here.
# On a physical phone use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
# Password-reset emails open the student website's reset page.
EXPO_PUBLIC_PASSWORD_RESET_URL=http://localhost:3000/reset-password
