-- Shared pgTAP helpers. Included by each *.test.sql via \ir; everything is created inside
-- the test's transaction and rolled back with it. Not a test file itself (.psql extension).

create extension if not exists pgtap with schema extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

-- Creates an auth user exactly as GoTrue would (fires the profile trigger).
create or replace function tests.create_user(p_id uuid, p_email text, p_meta jsonb default '{}')
returns uuid
language sql
as $$
  insert into auth.users (instance_id, id, aud, role, email, raw_user_meta_data, raw_app_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', p_id, 'authenticated', 'authenticated', p_email,
          p_meta, '{"provider":"email","providers":["email"]}', now(), now())
  returning id;
$$;

-- Switch the current transaction to an authenticated end-user session (what PostgREST and
-- the CampusCart API do for user requests), so RLS and column privileges apply.
create or replace function tests.authenticate_as(p_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create or replace function tests.as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

-- Back to the privileged test session (postgres) for setup and assertions.
create or replace function tests.as_superuser()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'postgres', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated;

-- Common fixture: two outlets, a manager + kitchen staff at A, a manager at B, two students,
-- and an admin. Fixed IDs so assertions read clearly.
create or replace function tests.seed_fixture()
returns void
language plpgsql
as $$
begin
  perform tests.create_user('10000000-0000-4000-a000-000000000001', 'admin@fixture.test', '{"full_name":"Fixture Admin"}');
  perform tests.create_user('10000000-0000-4000-a000-000000000002', 'mgr.a@fixture.test', '{"full_name":"Manager A"}');
  perform tests.create_user('10000000-0000-4000-a000-000000000003', 'kitchen.a@fixture.test', '{"full_name":"Kitchen A"}');
  perform tests.create_user('10000000-0000-4000-a000-000000000004', 'mgr.b@fixture.test', '{"full_name":"Manager B"}');
  perform tests.create_user('10000000-0000-4000-a000-000000000005', 'stu.1@fixture.test',
    '{"full_name":"Student One","roll_number":"FX-001","department":"CSE","year_of_study":"2"}');
  perform tests.create_user('10000000-0000-4000-a000-000000000006', 'stu.2@fixture.test',
    '{"full_name":"Student Two","roll_number":"FX-002"}');

  insert into public.outlets (id, slug, name) values
    ('20000000-0000-4000-b000-00000000000a', 'fixture-a', 'Fixture Outlet A'),
    ('20000000-0000-4000-b000-00000000000b', 'fixture-b', 'Fixture Outlet B'),
    ('20000000-0000-4000-b000-00000000000c', 'fixture-hidden', 'Fixture Hidden');
  update public.outlets set is_active = false where slug = 'fixture-hidden';

  insert into public.user_roles (user_id, role) values ('10000000-0000-4000-a000-000000000001', 'admin');
  insert into public.outlet_staff (outlet_id, user_id, role) values
    ('20000000-0000-4000-b000-00000000000a', '10000000-0000-4000-a000-000000000002', 'manager'),
    ('20000000-0000-4000-b000-00000000000a', '10000000-0000-4000-a000-000000000003', 'kitchen_staff'),
    ('20000000-0000-4000-b000-00000000000b', '10000000-0000-4000-a000-000000000004', 'manager');
end;
$$;

-- Phase 2 ordering fixture on top of seed_fixture():
--   outlet A (open, prefix 'A'): Chai (tracked, 5 left, low ≤ 2, prep 2), Sandwich (untracked,
--   prep 5), Samosa (tracked, 1 left, prep 3); outlet B (open): Coffee (untracked).
--   Slots: S1 A +1h cap 2 · S2 A +2h cap 1 · S3 A +1min cap 5 (too soon) · S4 B +1h cap 5.
create or replace function tests.seed_ordering_fixture()
returns void
language plpgsql
as $$
begin
  perform tests.seed_fixture();
  update public.outlets set status = 'open', token_prefix = 'A' where id = '20000000-0000-4000-b000-00000000000a';
  update public.outlets set status = 'open', token_prefix = 'B' where id = '20000000-0000-4000-b000-00000000000b';

  insert into public.menu_items (id, outlet_id, name, price_paise, prep_minutes, track_quantity) values
    ('30000000-0000-4000-d000-000000000001', '20000000-0000-4000-b000-00000000000a', 'Fixture Chai', 2000, 2, true),
    ('30000000-0000-4000-d000-000000000002', '20000000-0000-4000-b000-00000000000a', 'Fixture Sandwich', 7000, 5, false),
    ('30000000-0000-4000-d000-000000000003', '20000000-0000-4000-b000-00000000000a', 'Fixture Samosa', 1500, 3, true),
    ('30000000-0000-4000-d000-000000000004', '20000000-0000-4000-b000-00000000000b', 'Fixture Coffee', 5000, 3, false);
  insert into public.inventory (menu_item_id, quantity_available, low_stock_threshold) values
    ('30000000-0000-4000-d000-000000000001', 5, 2),
    ('30000000-0000-4000-d000-000000000003', 1, 0);

  insert into public.pickup_slots (id, outlet_id, starts_at, ends_at, capacity) values
    ('40000000-0000-4000-e000-000000000001', '20000000-0000-4000-b000-00000000000a', now() + interval '1 hour', now() + interval '75 minutes', 2),
    ('40000000-0000-4000-e000-000000000002', '20000000-0000-4000-b000-00000000000a', now() + interval '2 hours', now() + interval '135 minutes', 1),
    ('40000000-0000-4000-e000-000000000003', '20000000-0000-4000-b000-00000000000a', now() + interval '1 minute', now() + interval '16 minutes', 5),
    ('40000000-0000-4000-e000-000000000004', '20000000-0000-4000-b000-00000000000b', now() + interval '1 hour', now() + interval '75 minutes', 5);
end;
$$;

-- Place an order as p_user (end-user session), then return to the superuser session.
create or replace function tests.order_as(
  p_user uuid, p_slot uuid, p_items jsonb, p_key text,
  p_outlet uuid default '20000000-0000-4000-b000-00000000000a'
)
returns uuid
language plpgsql
as $$
declare
  v_id uuid;
begin
  perform tests.authenticate_as(p_user);
  v_id := app.create_order(p_outlet, p_slot, p_items, p_key, 'hash:' || p_key);
  perform tests.as_superuser();
  return v_id;
end;
$$;

-- Stand-in for a provider-verified payment (Phase 5 webhook). Superuser session only.
create or replace function tests.pay(p_order uuid)
returns void
language sql
as $$ select app.confirm_order_payment(p_order, 'test-payment:' || p_order::text); $$;

create or replace function tests.stock(p_item uuid)
returns integer
language sql
as $$ select quantity_available from public.inventory where menu_item_id = p_item; $$;

create or replace function tests.reserved(p_slot uuid)
returns integer
language sql
as $$ select reserved_count from public.pickup_slots where id = p_slot; $$;

-- Phase 4: kitchen A takes a paid order through to ready_for_pickup, then back to superuser.
create or replace function tests.kitchen_ready(p_order uuid)
returns void
language plpgsql
as $$
begin
  perform tests.authenticate_as('10000000-0000-4000-a000-000000000003');
  perform app.transition_order(p_order, 'confirmed');
  perform app.transition_order(p_order, 'preparing');
  perform app.transition_order(p_order, 'ready_for_pickup');
  perform tests.as_superuser();
end;
$$;

-- Moves a ready order (and its slot) into the past so its pickup deadline has passed.
create or replace function tests.make_overdue(p_order uuid, p_minutes integer default 30)
returns void
language plpgsql
as $$
begin
  update public.orders set ready_at = now() - make_interval(mins => p_minutes + 20) where id = p_order;
  update public.pickup_slots set starts_at = now() - make_interval(mins => p_minutes + 15),
                                 ends_at = now() - make_interval(mins => p_minutes)
  where id = (select pickup_slot_id from public.orders where id = p_order);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated;
