# CampusCart API — copy to .env for local development. Placeholders only.
CAMPUSCART_ENVIRONMENT=local
CAMPUSCART_LOG_LEVEL=INFO
CAMPUSCART_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:8081"]

# Supabase (Phase 1). For the local stack, `eval "$(bash ../../scripts/supabase-env.sh)"`
# exports these. Server-side only — never expose DATABASE_URL to clients.
CAMPUSCART_SUPABASE_URL=http://127.0.0.1:54321
CAMPUSCART_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Only if the project still signs tokens with the legacy HS256 secret:
# CAMPUSCART_SUPABASE_JWT_SECRET=server-only
CAMPUSCART_JWT_AUDIENCE=authenticated
